
# 让 Git LFS 管理 UE 二进制资产（必须安装 lfs）
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# 其他常见大文件（可选，按需添加）
*.exe    filter=lfs diff=lfs merge=lfs -text
*.dll    filter=lfs diff=lfs merge=lfs -text
*.pdb    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text

# 文本文件（统一换行符，便于 diff）
*.cpp    text diff=cpp
*.h      text diff=cpp
*.c      text
*.cs     text diff=csharp
*.ini    text diff=ini
*.uproject text json
*.uplugin  text json
*.Build.cs text
*.Target.cs text
*.xml    text
*.json   text
*.txt    text

# 工程文件（按文本处理，不推荐提交 .sln / .vcxproj.user，但若提交则设为文本）
*.sln    text eol=crlf
*.vcxproj text
*.filter text

# 避免 diff 二进制噪音
*.zip    -diff
*.rar    -diff
*.7z     -diff
*.pak    -diff
*.ubulk  -diff
*.uexp   -diff

# 让 sh / bash 脚本保留 LF 换行符（适用于 .sh 在 UE 构建过程中）
*.sh     text eol=lf
*.py     text eol=lf
